# Template only — copy to `.env` and fill in YOUR OWN credentials.
# The repository ships no keys, and no file here may ever hold a real one.
#
# Preferred: 豆包流式语音识别 2.0 (SeedASR) for word-level timestamps.
# Get this AppID/token pair from the 火山引擎 *speech* console
# (语音技术 → 流式语音识别). It is NOT the 火山方舟 (Ark) LLM key below.
DOUBAO_APP_ID=
DOUBAO_ACCESS_TOKEN=
#
# Optional second engine for cross-checking: ElevenLabs Scribe.
ELEVENLABS_API_KEY=
#
# 火山方舟 LLM key. Historical fallback only — a generic multimodal model,
# never a word-level ASR. Keep it blank unless you actually need that path.
ARK_API_KEY=
